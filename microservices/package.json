{
  "name": "parking-microservices-root",
  "version": "1.0.0",
  "description": "Monorepo de microservicios Serverless para Parqueadero App con Arquitectura Hexagonal y DynamoDB",
  "private": true,
  "workspaces": [
    "ms_parking_auth",
    "ms_parking_rates_config",
    "ms_parking_vehicles",
    "ms_parking_sessions",
    "ms_parking_notifications"
  ],
  "scripts": {
    "build:all": "./scripts/build-all.sh",
    "package:all": "./scripts/build-all.sh",
    "clean:all": "npm run clean --workspaces --if-present",
    "dynamo:create-tables": "node scripts/create-dynamo-tables.js",
    "dynamo:seed": "node scripts/seed-dynamo-data.js",
    "deploy:sam": "./scripts/deploy-aws.sh",
    "clean:install": "npx rimraf -g package-lock.json node_modules \"ms_parking_*/node_modules\" \"ms_parking_*/package-lock.json\" && npm install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.6.4",
    "bcryptjs": "^3.0.3",
    "bestzip": "^4.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.0"
  }
}
