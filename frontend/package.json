    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "^8.0.0",
    "@primeuix/themes": "^2.0.3",
    "chart.js": "^4.5.1",
    "ionicons": "^8.1.0",
    "jsbarcode": "^3.12.3",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@capacitor/cli": "8.3.5",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
